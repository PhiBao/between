{
  "name": "between",
  "version": "0.1.0",
  "private": true,
  "description": "The neutral record between two homes. A co-parenting record that de-escalates messages and tracks what was actually agreed.",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:push": "supabase db push --linked",
    "seed": "tsx scripts/seed.ts",
    "check:retention": "tsx scripts/check-retention.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.58.0",
    "next": "15.5.23",
    "pdf-lib": "1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "4.1.13",
    "tsx": "4.21.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
