# Copy to .env.local and fill in. Never commit .env.local.
#
# The app runs with ONLY the two Supabase values set: the AI layer falls back to a
# deterministic offline provider, so you can develop and test with no model access.

# --- Supabase (required) ----------------------------------------------------
# Project settings -> API. The anon key is safe in the browser; Row Level
# Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses RLS. Used only by scripts/seed.ts and /api/jobs/tick. Never expose it
# to the browser and never use it to serve a user request.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (optional) -------------------------------------------------
# mock   = deterministic, offline, rule-based. The default, and what tests use.
# mantle = Amazon Bedrock through the bedrock-mantle endpoint.
AI_PROVIDER=mock

# Bedrock's OpenAI-compatible endpoint. Region must be one where bedrock-mantle
# is available (us-east-1, us-east-2, us-west-2, eu-west-1, eu-west-2, ...).
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1

# A Bedrock API key. No IAM access key or secret is needed.
BEDROCK_API_KEY=your-bedrock-api-key

# Must be a model that permits data_retention_mode "none". Verify with
# `pnpm check:retention` before deploying.
BEDROCK_MODEL_ID=openai.gpt-oss-120b

# --- Application ------------------------------------------------------------
# Shared secret for POST /api/jobs/tick. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=generate-a-long-random-string

# Used to build invite links. Must match the deployed origin in production.
APP_URL=http://localhost:3000
